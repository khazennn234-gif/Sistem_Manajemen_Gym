# CodeIgniter 4 Environment & Secrets
.env

# Composer dependencies
/vendor/

# Temporary / Generated files inside writable/
/writable/cache/*
!/writable/cache/index.html
!/writable/cache/.gitkeep

/writable/logs/*
!/writable/logs/index.html
!/writable/logs/.gitkeep

/writable/session/*
!/writable/session/index.html
!/writable/session/.gitkeep

/writable/debugbar/*
!/writable/debugbar/index.html
!/writable/debugbar/.gitkeep

/writable/uploads/*
!/writable/uploads/index.html
!/writable/uploads/.gitkeep

# IDE & OS files
.vscode/
.idea/
*.suo
*.user
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Database dumps / backups (kecuali skrip migrasi/seeder di app/Database)
*.sql
*.sqlite
